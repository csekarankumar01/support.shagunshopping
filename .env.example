POSTGRES_USER=helpdesk
POSTGRES_PASSWORD=change-me
POSTGRES_DB=helpdesk
POSTGRES_PORT=5432
POSTGRES_HOST=localhost
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN_SECONDS=3600
APP_DB_USER=helpdesk_app
APP_DB_PASSWORD=change-me

# Port the NestJS API listens on (the Next.js app runs on 4311)
PORT=4310

# Browser origin(s) allowed to open a WebSocket to the API (comma-separated). Defaults to http://localhost:4311.
FRONTEND_ORIGIN=http://localhost:4311

# Redis (presence, SLA timers)
REDIS_HOST=localhost
REDIS_PORT=4379
REDIS_PASSWORD=change-me

# Kafka-compatible broker (Redpanda)
KAFKA_PORT=4092
KAFKA_BROKERS=localhost:4092

# Local mail catcher (Mailpit): SMTP in, web inbox out
SMTP_HOST=localhost
SMTP_PORT=4025
MAIL_UI_PORT=4026
MAIL_FROM=helpdesk@localhost

# Host port the Next.js container publishes (the API uses PORT above)
FRONTEND_PORT=4311
