POSTGRES_USER=helpdesk
POSTGRES_PASSWORD=change-me
POSTGRES_DB=helpdesk
POSTGRES_PORT=5432
POSTGRES_HOST=localhost
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN_SECONDS=900
APP_DB_USER=helpdesk_app
APP_DB_PASSWORD=change-me

# true = a platform (super) admin without two-factor sign-in cannot sign in at all. Set it in production.
# Set up two-factor with: npm run platform:2fa -- you@example.com   (in helpdesk-backend/)
PLATFORM_REQUIRE_2FA=false

# Port the NestJS API listens on (the Next.js app runs on 4311)
PORT=4310

# Browser origin(s) allowed to open a WebSocket to the API (comma-separated). Defaults to http://localhost:4311.
FRONTEND_ORIGIN=http://localhost:4311

# Redis (presence, SLA timers)
REDIS_HOST=localhost
REDIS_PORT=4379
REDIS_PASSWORD=change-me

# Kafka-compatible broker (Redpanda)
KAFKA_PORT=4092
KAFKA_BROKERS=localhost:4092

# Local mail catcher (Mailpit): SMTP in, web inbox out
SMTP_HOST=localhost
SMTP_PORT=4025
MAIL_UI_PORT=4026
MAIL_FROM=helpdesk@localhost

# Host port the Next.js container publishes (the API uses PORT above)
FRONTEND_PORT=4311

# Optional: set a long random value to switch on GET /api/v1/metrics (Prometheus format, Bearer token). Empty = off.
METRICS_TOKEN=

# Real email in production (the defaults below point at the local Mailpit catcher).
# SMTP_TLS=starttls
# SMTP_RELAY_HOST=smtp.your-provider.example
# SMTP_RELAY_PORT=587
# SMTP_USER=...
# SMTP_PASSWORD=...
# MAIL_FROM="Help Desk <support@your-domain.example>"
